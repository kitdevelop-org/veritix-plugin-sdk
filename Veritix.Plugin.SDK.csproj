<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Veritix.Plugin.SDK</AssemblyName>
    <RootNamespace>Veritix.Plugin.SDK</RootNamespace>

    <!-- NuGet metadata -->
    <PackageId>Veritix.Plugin.SDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>KitDevelop S.R.L.</Authors>
    <Company>KitDevelop S.R.L.</Company>
    <Description>SDK oficial para el desarrollo de plugins para Veritix ERP</Description>
    <PackageTags>veritix;erp;plugin;sdk;kitdevelop</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Incluir Common.targets para que sea consumido automáticamente por los plugins -->
    <None Include="Veritix.Plugin.Common.targets" Pack="true" PackagePath="build\Veritix.Plugin.SDK.targets" />
  </ItemGroup>

</Project>